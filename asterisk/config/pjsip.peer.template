; --- WebRTC peer __EXT__ (generated per 1001-1020) ---
[__EXT__]
type=endpoint
transport=transport-ws
context=from-internal
disallow=all
allow=ulaw
allow=alaw
auth=__EXT__
aors=__EXT__
callerid="Agente __EXT__" <__EXT__>
direct_media=no
ice_support=yes
media_use_received_transport=yes
webrtc=yes
; Let Asterisk generate and manage the self-signed DTLS cert itself. This
; guarantees the SDP fingerprint always matches the cert used on the DTLS
; handshake (a mismatch silently breaks SRTP decrypt -> packets arrive but
; the browser never plays audio).
dtls_auto_generate_cert=yes
dtls_verify=fingerprint
dtls_setup=actpass
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

[__EXT__]
type=aor
max_contacts=2
remove_existing=yes

[__EXT__]
type=auth
auth_type=userpass
username=__EXT__
password=__PEER_SECRET__
