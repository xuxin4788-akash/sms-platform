; === PJSIP base config: transport + VOS3000 static-IP trunk ===
; The 1001-1020 WebRTC peers are appended below by entrypoint.sh.

[transport-ws]
type=transport
protocol=ws
bind=0.0.0.0
; Advertise the public host so Contact / SDP are reachable through NAT.
external_signaling_address=__EXTERNAL_IP__
external_media_address=__EXTERNAL_IP__
local_net=__LOCAL_NET__

; UDP transport used ONLY for the VOS3000 trunk (plain SIP/RTP, not WebRTC).
[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
; Without these, the SDP advertises the container IP (172.x) and VOS3000 sends
; RTP to an unreachable address -> call connects but no audio.
external_signaling_address=__EXTERNAL_IP__
external_media_address=__EXTERNAL_IP__
local_net=__LOCAL_NET__

; ---- VOS3000 IP trunk (authenticates by our static source IP, no register) ----
[trunk-vos3000]
type=endpoint
transport=transport-udp
context=from-trunk
disallow=all
allow=ulaw
allow=alaw
aors=trunk-vos3000
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
; WARNING: do NOT add jitterbuffer/jb_* options on pjsip endpoints — those are
; chan_sip-era params; res_pjsip silently REJECTS the entire endpoint object on
; unknown options (this killed trunk-vos3000 and the managed trunks: calls died
; with local 603/404 while the endpoint was "not found"). If a low-latency
; jitter buffer is needed, use the JITTERBUFFER() dialplan function instead.
; From-DID passthrough lets the provider route inbound DIDs if added later.

[trunk-vos3000]
type=aor
contact=sip:__TRUNK_HOST__:__TRUNK_PORT__\;transport=udp
qualify_frequency=30

[trunk-vos3000]
type=identify
endpoint=trunk-vos3000
match=__TRUNK_HOST__

; ---- Lineas de operador gestionadas por web (#/sip-trunks) ----
; Endpoint/aor/identify generados por app.py en el volumen compartido.
; Ruta ABSOLUTA renderizada por entrypoint.sh (__TRUNK_DYN_DIR__). Una ruta
; relativa resolveria contra /etc/asterisk y el fragmento no se cargaria.
#tryinclude "__TRUNK_DYN_DIR__/pjsip-trunks.conf"

; ---- Clientes SIP entrantes: NOSOTROS les damos linea (#/client-trunks) ----
; Endpoint (IP whitelist) + identify generados por app.py. Sin registro ni AOR.
#tryinclude "__TRUNK_DYN_DIR__/pjsip-inbound.conf"
