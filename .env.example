# SMS Marketing Platform - Environment Configuration
# Copy this file to .env and update the values

# Database
DB_PASSWORD=your_secure_password_here

# Flask
FLASK_SECRET_KEY=generate_a_random_hex_string_here

# Deployment environment: 'production' (default) or 'test'.
# 'test' shows a persistent orange ribbon on every page so users do not
# mistake the test server for production.
APP_ENVIRONMENT=production
# APP_LABEL=ENTORNO DE PRUEBAS

# Optional: Override default ports
# DEPLOY_RUN_PORT=5000

# Public domain served by nginx (server_name + Let's Encrypt certificate path).
#   Test server:  DOMAIN=test.pagoserve.com
#   Production:   DOMAIN=pagoserve.com
DOMAIN=pagoserve.com

# Short links (SMS payment/collection links are shortened to <base>/l/<code>).
# If unset, the host that received the request is used. Set a public HTTPS
# base domain so SMS recipients can open it. Usually https://<DOMAIN>.
SHORT_LINK_BASE_URL=https://pagoserve.com

# Let's Encrypt certificate. Issue it on the host before the first nginx start,
# then it is mounted read-only into the nginx container:
#   mkdir -p nginx/certbot/www
#   # stop nginx first (it occupies port 80) for the initial standalone issue:
#   docker compose stop nginx
#   certbot certonly --standalone -d <DOMAIN> --agree-tos -m admin@pagoserve.com -n
#   # afterwards switch renewal to webroot so it works while nginx is running:
#   certbot certonly --webroot -w $(pwd)/nginx/certbot/www -d <DOMAIN> \
#     --force-renewal --non-interactive --agree-tos -m admin@pagoserve.com
#   certbot renew --dry-run
#
# (Optional) auto-reload nginx after each successful certificate renewal:
#   printf '#!/bin/sh\ncd %s && docker compose restart nginx\n' "$(pwd)" \
#     > /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh
#   chmod +x /etc/letsencrypt/renewal-hooks/deploy/reload-nginx.sh
