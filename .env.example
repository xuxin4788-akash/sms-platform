# SMS Marketing Platform - Environment Configuration
# Copy this file to .env and update the values

# Database
DB_PASSWORD=your_secure_password_here

# Flask
FLASK_SECRET_KEY=generate_a_random_hex_string_here

# Deployment environment: 'production' (default) or 'test'.
# 'test' shows a persistent orange ribbon on every page so users do not
# mistake the test server for production.
APP_ENVIRONMENT=production
# APP_LABEL=ENTORNO DE PRUEBAS

# Optional: Override default ports
# DEPLOY_RUN_PORT=5000

# Short links (SMS payment/collection links are shortened to <base>/l/<code>).
# If unset, the host that received the request is used. Set a public HTTPS
# base domain so SMS recipients can open it.
SHORT_LINK_BASE_URL=https://pagoserve.com

# Let's Encrypt domain served by the nginx proxy. Issue the certificate on the
# host before the first nginx start, then it is mounted read-only into nginx:
#   mkdir -p nginx/certbot/www
#   certbot certonly --standalone -d pagoserve.com --agree-tos -m admin@pagoserve.com -n
CERTBOT_DOMAIN=pagoserve.com
